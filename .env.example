# Copy this file to .env and fill in your own values. Never commit .env.

# Groq API key for the LLM (https://console.groq.com/keys)
GROQ_API_KEY=

# LlamaParse API key, only needed to ingest PDFs (https://cloud.llamaindex.ai)
LLAMA_CLOUD_API_KEY=

# MySQL connection for cold storage
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=cold_storage
